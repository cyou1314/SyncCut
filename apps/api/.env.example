NODE_ENV=development
PORT=8787
DATABASE_URL=postgresql://synccut:change-me@127.0.0.1:5432/synccut

# Server-side Feishu app: custom_app for one enterprise; store_app for approved personal-user access.
FEISHU_APP_MODE=custom_app
# App credentials must match the configured app mode.
# Keep these values on the API server only.
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Generate a 32-byte key and store it in a secret manager.
# Used by the credential-encryption module when it is added.
SYNC_CREDENTIAL_ENCRYPTION_KEY=

# Exact server origin, without a trailing slash. HTTPS required except loopback HTTP.
PUBLIC_ORIGIN=http://127.0.0.1:8787
